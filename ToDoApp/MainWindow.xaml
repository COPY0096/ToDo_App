<Window x:Class="ToDoApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoApp.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10" Loaded="Grid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox Width="250" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Width="250" Margin="8,0,0,0" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" />
            <DatePicker Width="160" Margin="8,0,0,0" SelectedDate="{Binding NewFechaVencimiento, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Add" Margin="10,0,0,0" Padding="10,4" Command="{Binding AddTaskCommand}" />
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsDone}" Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Description}" FontStyle="Italic" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Created: " FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FechaCreacion, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                    <TextBlock Text="  Due: " FontWeight="SemiBold" Margin="12,0,0,0" />
                                    <DatePicker SelectedDate="{Binding FechaVencimiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Delete" Margin="8,0,0,0" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                        </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>
