<Window x:Class="ToDoApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoApp.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:ToDoApp.Models"
        xmlns:vm="clr-namespace:ToDoApp.ViewModels"
        mc:Ignorable="d"
        Title="ToDoApp" Height="520" Width="1000">
    <Window.Resources>
        <!-- Fuente de valores del enum Estado (Pendiente/Completado/Cancelado) para el ComboBox -->
        <ObjectDataProvider x:Key="EstadoValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TodoEstado" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Subtarea (Sprint 3): plantilla explícita (x:Key, no implícita por DataType) para
             que el ItemsControl de SubTasks la use en vez de la tarjeta completa de arriba —
             evita que una subtarea vuelva a mostrar su propio "+ Add a subtask" (límite de
             un solo nivel). Solo título + checkbox, sin descripción ni fecha propia. -->
        <DataTemplate x:Key="SubTaskTemplate" DataType="{x:Type models:TodoItem}">
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" FontSize="11"
                         BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center"
                         ToolTip="Hacé clic para editar el título de la subtarea">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Content="✕" FontSize="9" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                        ToolTip="Eliminar subtarea"
                        Command="{Binding DataContext.DeleteSubTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                        CommandParameter="{Binding}" />
            </StackPanel>
        </DataTemplate>

        <!-- Tarjeta de tarea: plantilla implícita para TodoItem, reutilizada tanto en
             la lista activa como en "Completed" de cada columna. -->
        <DataTemplate DataType="{x:Type models:TodoItem}">
            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                    Padding="8" Margin="0,0,0,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="4" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFF3CD" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="Completado">
                                            <Setter Property="Background" Value="#D4EDDA" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="Cancelado">
                                            <Setter Property="Background" Value="#F8D7DA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ComboBox Width="100" BorderThickness="0" Background="Transparent"
                                      ItemsSource="{Binding Source={StaticResource EstadoValues}}"
                                      SelectedItem="{Binding Estado, Mode=TwoWay}"
                                      ToolTip="Estado de la tarea" />
                        </Border>
                        <Button Content="Eliminar" FontSize="10" Padding="4,1" VerticalAlignment="Center"
                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" FontWeight="Bold"
                             BorderThickness="0" Background="Transparent" Padding="0" Margin="0,4,0,0"
                             ToolTip="Hacé clic para editar el título" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" FontStyle="Italic" FontSize="12"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             ToolTip="Hacé clic para editar la descripción" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Creado: " FontWeight="SemiBold" FontSize="10" />
                        <TextBlock Text="{Binding FechaCreacion, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="10" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Fecha límite: " FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                        <DatePicker SelectedDate="{Binding FechaVencimiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Cambiar la fecha límite de esta tarea" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Lista: " FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                        <ComboBox FontSize="10" MinWidth="90"
                                  ItemsSource="{Binding DataContext.Lists, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                  DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                  SelectedValue="{Binding TodoListId, Mode=OneWay}"
                                  SelectionChanged="MoveTask_SelectionChanged"
                                  ToolTip="Mover esta tarea a otra lista" />
                    </StackPanel>

                    <!-- Subtareas (Sprint 3): indentadas debajo de la tarjeta de su padre;
                         nunca aparecen como tarjetas sueltas en la columna. -->
                    <ItemsControl ItemsSource="{Binding SubTasks}" ItemTemplate="{StaticResource SubTaskTemplate}"
                                  Margin="16,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                        <TextBox Width="110" FontSize="11" Text="{Binding NewSubTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Título de la nueva subtarea" />
                        <Button Content="+ Add a subtask" FontSize="10" Padding="4,1" Margin="6,0,0,0"
                                Command="{Binding DataContext.AddSubTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Agregar subtarea a esta tarea" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Columna del board: plantilla implícita para TodoListColumnViewModel. -->
        <DataTemplate DataType="{x:Type vm:TodoListColumnViewModel}">
            <Border Width="260" Margin="0,0,12,0" Padding="10" VerticalAlignment="Top"
                    Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Nombre, UpdateSourceTrigger=LostFocus}"
                                 FontWeight="Bold" FontSize="14" BorderThickness="0" Background="Transparent" Padding="0"
                                 ToolTip="Hacé clic para renombrar la lista" />
                        <Button Grid.Column="1" Content="Eliminar" FontSize="10" Padding="4,2"
                                Click="DeleteList_Click" ToolTip="Eliminar esta lista">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsPredeterminada}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="150" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Título de la nueva tarea" />
                        <Button Content="+ Add a task" Margin="6,0,0,0" Padding="8,2" Command="{Binding AddTaskCommand}"
                                ToolTip="Agregar tarea a esta lista" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Items}" />

                    <Expander Header="{Binding CompletedHeaderText}"
                              IsExpanded="{Binding IsCompletedExpanded, Mode=TwoWay}" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding CompletedItems}" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10" Loaded="Grid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Main Board" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Lists}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Width="200" Padding="10" VerticalAlignment="Top"
                        Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="+ Add new list" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nombre de la nueva lista" />
                        <Button Content="Agregar lista" Margin="0,6,0,0" Command="{Binding AddListCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
