<Window x:Class="ToDoApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoApp.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:ToDoApp.Models"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <!-- Fuente de valores del enum Estado (Pendiente/Completado/Cancelado) para el ComboBox -->
        <ObjectDataProvider x:Key="EstadoValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TodoEstado" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid Margin="10" Loaded="Grid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Título *" FontSize="11" Foreground="Gray" />
                    <TextBox Width="200" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nombre corto de la tarea (obligatorio)" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Descripción" FontSize="11" Foreground="Gray" />
                    <TextBox Width="220" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Detalles opcionales de la tarea" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Fecha límite" FontSize="11" Foreground="Gray" />
                    <DatePicker Width="160" SelectedDate="{Binding NewFechaVencimiento, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Fecha límite para completar la tarea (opcional)" />
                </StackPanel>
                <Button Content="Agregar" Margin="10,0,0,0" Padding="10,4" VerticalAlignment="Bottom"
                        Command="{Binding AddTaskCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding ValidationMessage}" Foreground="#C0392B" FontSize="12" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ValidationMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <Border CornerRadius="4" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFF3CD" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Estado}" Value="Completado">
                                                <Setter Property="Background" Value="#D4EDDA" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Estado}" Value="Cancelado">
                                                <Setter Property="Background" Value="#F8D7DA" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ComboBox Width="110" BorderThickness="0" Background="Transparent"
                                          ItemsSource="{Binding Source={StaticResource EstadoValues}}"
                                          SelectedItem="{Binding Estado, Mode=TwoWay}"
                                          ToolTip="Estado de la tarea" />
                            </Border>
                            <StackPanel>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" FontWeight="Bold"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         ToolTip="Hacé clic para editar el título" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" FontStyle="Italic" FontSize="12"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         ToolTip="Hacé clic para editar la descripción" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Creado: " FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding FechaCreacion, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="11" />
                                    <TextBlock Text="  Fecha límite: " FontWeight="SemiBold" FontSize="11" Margin="12,0,0,0" />
                                    <DatePicker SelectedDate="{Binding FechaVencimiento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="Cambiar la fecha límite de esta tarea" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Eliminar" Margin="8,0,0,0" VerticalAlignment="Top"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>
